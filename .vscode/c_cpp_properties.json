                "${WATCOM}/h",
                "${workspaceFolder}/**"
            ],
            "defines": [
                "_DEBUG",
                "UNICODE",
                "_UNICODE",
                "__X86__",
                "M_I86",
                "_M_I86",
                "_M_IX86=0",
                "__DOS__",
                "_DOS",
                "MSDOS",
                "__SMALL__=1",
                "_M_I86SM=__SMALL__",
                "M_I86SM=__SMALL__",
                "__cplusplus=1",
                "__WATCOMC__=1300",
                "_INTEGRAL_MAX_BITS=32",
                "_PUSHPOP_SUPPORTED=1",
