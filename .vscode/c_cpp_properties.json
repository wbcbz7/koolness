                "__watcall=",
                "far=",
                "_far=",
                "__far=",
                "interrupt=",
                "_interrupt=",
                "__interrupt=",
                "asm=__asm",
                "__declspec(x)=",
                "__cdecl=\"",
                "MK_FP(s,o)"
            ],
            "windowsSdkVersion": "10.0.22621.0",
            "compilerPath": "cl.exe",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "windows-msvc-x64"
